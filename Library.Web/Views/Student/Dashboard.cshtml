@model Library.Web.ViewModels.StudentDashboardViewModel
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}

@section Styles {
    <style>
        /* [KEEPING ALL YOUR ORIGINAL CSS] */
        .welcome-section {
            margin-bottom: 30px;
            animation: fadeInDown 0.6s ease-out;
        }

            .welcome-section h1 {
                font-size: 28px;
                color: #1a202c;
                font-weight: 700;
                margin-bottom: 5px;
            }

            .welcome-section p {
                color: #718096;
                font-size: 15px;
            }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
            animation: fadeInUp 0.8s ease-out;
        }

        .stat-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid #edf2f7;
        }

            .stat-card:hover {
                transform: translateY(-5px);
            }

        .stat-info h3 {
            font-size: 14px;
            color: #a0aec0;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .stat-info p {
            font-size: 32px;
            font-weight: 700;
            color: #2d3748;
            line-height: 1;
        }

        .stat-split {
            display: flex;
            gap: 15px;
            margin-top: 10px;
        }

        .stat-item {
            text-align: center;
            flex: 1;
        }

            .stat-item span {
                display: block;
                font-size: 10px;
                color: #a0aec0;
                font-weight: 600;
                text-transform: uppercase;
            }

            .stat-item b {
                font-size: 22px;
                color: #667eea;
            }

        .divider {
            width: 1px;
            background: #edf2f7;
            height: 35px;
            align-self: center;
        }

        .stat-icon {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .icon-green {
            background-color: rgba(72, 187, 120, 0.15);
            color: #38a169;
        }

        .icon-red {
            background-color: rgba(245, 101, 101, 0.15);
            color: #e53e3e;
        }

        .table-section {
            background: #ffffff;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            border: 1px solid #edf2f7;
            margin-bottom: 30px;
        }

        .styled-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 15px;
        }

            .styled-table thead tr {
                background-color: #f7fafc;
                color: #718096;
            }

            .styled-table th, .styled-table td {
                padding: 15px 20px;
                border-bottom: 1px solid #edf2f7;
            }

        .type-badge {
            font-size: 11px;
            padding: 5px 10px;
            border-radius: 6px;
            background: #f7fafc;
            border: 1px solid #e2e8f0;
            color: #4a5568;
        }

        .status-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 9999px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-borrowed {
            background-color: rgba(66, 153, 225, 0.15);
            color: #3182ce;
        }

        .status-due {
            background-color: rgba(245, 101, 101, 0.15);
            color: #e53e3e;
        }

        .status-pending {
            background-color: rgba(236, 163, 17, 0.15);
            color: #b7791f;
        }

        .filter-group {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .filter-btn {
            padding: 6px 15px;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            background: #fff;
            cursor: pointer;
            font-size: 13px;
            transition: 0.3s;
        }

            .filter-btn.active {
                background: #667eea;
                color: white;
                border-color: #667eea;
            }
    </style>
}

<div class="welcome-section">
    <h1>Welcome Back, @Model.StudentName! 👋</h1>
    <p>Here's a quick look at your library activity today.</p>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-info" style="width: 100%;">
            <h3>Library Assets</h3>
            <div class="stat-split">
                <div class="stat-item">
                    <b>@Model.BooksCount.ToString("00")</b>
                    <span>Books</span>
                </div>
                <div class="divider"></div>
                <div class="stat-item">
                    <b>@Model.ThesesCount.ToString("00")</b>
                    <span>Theses</span>
                </div>
                <div class="divider"></div>
                <div class="stat-item">
                    <b>@Model.JournalsCount.ToString("00")</b>
                    <span>Journals</span>
                </div>
            </div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <h3>Active Reservations</h3>
            <p>@Model.ActiveReservationsCount.ToString("00")</p>
        </div>
        <div class="stat-icon icon-green">🔖</div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <h3>Pending Fines</h3>
            <p>PKR @Model.PendingFines.ToString("0.00")</p>
        </div>
        <div class="stat-icon icon-red">💰</div>
    </div>
</div>

<div class="table-section">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2>Current Activity (Borrowed)</h2>
        <div class="filter-group">
            <button class="filter-btn active" onclick="filterData('All', this)">All</button>
            <button class="filter-btn" onclick="filterData('Book', this)">Books</button>
            <button class="filter-btn" onclick="filterData('Thesis', this)">Theses</button>
            <button class="filter-btn" onclick="filterData('Journal', this)">Journals</button>
        </div>
    </div>

    <table class="styled-table" id="activityTable">
        <thead>
            <tr>
                <th>Type</th>
                <th>Item Name</th>
                <th>Borrowed Date</th>
                <th>Due Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.BorrowedItems != null && Model.BorrowedItems.Any())
            {
                foreach (var item in Model.BorrowedItems)
                {
                    <tr class="activity-row" data-type="@item.Type">
                        <td>
                            <span class="type-badge">
                                @(item.Type == "Thesis" ? "🎓 Thesis" : item.Type == "Journal" ? "📑 Journal" : "📚 Book")
                            </span>
                        </td>
                        <td><strong>@item.Title</strong></td>
                        <td>@item.BorrowedDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.DueDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (item.Status == "Pending")
                            {
                                <span class="status-badge status-pending">Wait for Admin</span>
                            }
                            else if (item.IsDueSoon)
                            {
                                <span class="status-badge status-due">Due Soon</span>
                            }
                            else
                            {
                                <span class="status-badge status-borrowed">Borrowed</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5" class="text-center text-muted">No borrowed items.</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="table-section">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2>Active Reservations</h2>
    </div>

    <table class="styled-table" id="reservationTable">
        <thead>
            <tr>
                <th>Type</th>
                <th>Item Name</th>
                <th>Reservation Date</th>
                <th>Expiry Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ReservedItems != null && Model.ReservedItems.Any())
            {
                foreach (var item in Model.ReservedItems)
                {
                    <tr class="activity-row" data-type="@item.ItemType">
                        <td>
                            <span class="type-badge">
                                @(item.ItemType == "Thesis" ? "🎓 Thesis" : item.ItemType == "Journal" ? "📑 Journal" : "📚 Book")
                            </span>
                        </td>
                        <td><strong>@item.Title</strong></td>
                        <td>@item.ReservationDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.ExpiryDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (item.Status == "Pending")
                            {
                                <span class="status-badge status-pending">Wait for Admin</span>
                            }
                            else
                            {
                                <span class="status-badge status-borrowed">Reserved</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5" class="text-center text-muted">No active reservations.</td></tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        function filterData(type, btn) {
            // Update active button state
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            // Apply filter to all tables containing '.activity-row'
            const rows = document.querySelectorAll('.activity-row');
            rows.forEach(row => {
                const rowType = row.getAttribute('data-type');
                if (type === 'All' || rowType === type) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>
}