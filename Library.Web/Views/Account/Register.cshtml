@model Library.Domain.Entities.Student

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Library Management System - Register</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .container {
            display: flex;
            width: 100%;
            max-width: 1200px;
            min-height: 650px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px(60px) rgba(0, 0, 0, 0.12);
            overflow: hidden;
            animation: slideIn 0.8s ease-out;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .left-section {
            flex: 0.8;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 60px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            position: relative;
            overflow: hidden;
        }

            /* Ambient animated glowing circles behind the library icon */
            .left-section::before, .left-section::after {
                content: '';
                position: absolute;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.1);
                animation: float 6s ease-in-out infinite;
                z-index: 0;
            }

            .left-section::before {
                width: 300px;
                height: 300px;
                top: -100px;
                left: -100px;
            }

            .left-section::after {
                width: 200px;
                height: 200px;
                bottom: -50px;
                right: -50px;
                animation-delay: -3s;
            }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0) scale(1);
            }

            50% {
                transform: translateY(-10px) scale(1.05);
            }
        }

        .library-icon {
            font-size: 60px;
            margin-bottom: 20px;
            animation: bounce 2s ease-in-out infinite;
            z-index: 1;
        }

        @@keyframes bounce {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }
        }

        .left-section h2 {
            font-size: 32px;
            margin-bottom: 15px;
            text-align: center;
            z-index: 1;
        }

        .left-section p {
            font-size: 14px;
            text-align: center;
            opacity: 0.9;
            z-index: 1;
            line-height: 1.6;
        }

        .right-section {
            flex: 1.2;
            padding: 40px 50px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: #fafbfc;
        }

            .right-section h1 {
                font-size: 28px;
                color: #2d3748;
                margin-bottom: 5px;
            }

        /* 2-Column Grid layout for inputs */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            transition: transform 0.3s ease; /* Matches the smooth JS slide effect */
        }

            .form-group.full-width {
                grid-column: span 2;
            }

        label {
            display: block;
            margin-bottom: 6px;
            color: #2d3748;
            font-weight: 600;
            font-size: 13px;
        }

        input[type="text"],
        input[type="password"],
        select {
            width: 100%;
            padding: 11px 15px;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            font-size: 14px;
            transition: all 0.3s ease;
            font-family: inherit;
        }

            input[type="text"]:focus,
            input[type="password"]:focus,
            select:focus {
                outline: none;
                border-color: #667eea;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
                background: #ffffff;
            }

        .register-btn {
            width: 100%;
            padding: 13px 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 15px;
        }

            .register-btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
            }

        .back-link {
            text-align: center;
            margin-top: 20px;
            font-size: 14px;
            color: #718096;
        }

            .back-link a {
                color: #667eea;
                font-weight: 600;
                text-decoration: none;
                transition: color 0.3s ease;
            }

                .back-link a:hover {
                    color: #764ba2;
                    text-decoration: underline;
                }

        @@media (max-width: 768px) {
            .container {
                flex-direction: column;
                height: auto;
            }

            .left-section {
                min-height: 200px;
                padding: 30px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full-width {
                grid-column: span 1;
            }

            .right-section {
                padding: 30px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="left-section">
            <div class="library-icon">📖</div>
            <h2>Join Our Library</h2>
            <p>Create a student account today and get instant access to borrow thousands of educational resources.</p>
        </div>

        <div class="right-section">
            <h1>Create Account</h1>
            <p style="color: #718096;">Please fill in your details to register</p>

            <form asp-controller="Account" asp-action="Register" method="post">
                <div class="form-grid">

                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text" asp-for="StudentName" placeholder="Enter your full name" required>
                    </div>

                    <div class="form-group">
                        <label>Roll Number</label>
                        <input type="text" asp-for="RollNo" placeholder="e.g. CS-101" required>
                    </div>
                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="text" asp-for="Email" placeholder="Enter your email" required>
                    </div>
                    <div class="form-group">
                        <label>Username</label>
                        <input type="text" asp-for="Username" placeholder="Choose a username" required>
                    </div>

                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" asp-for="PasswordHash" placeholder="Create a password" required>
                    </div>

                    <div class="form-group">
                        <label>Phone Number</label>
                        <input type="text" asp-for="PhoneNumber" placeholder="Optional contact number">
                    </div>

                    <div class="form-group">
                        <label>Department</label>
                        <select asp-for="Department" required>
                            <option value="" disabled selected>Select Department</option>
                            <option value="Computer Science">Computer Science</option>
                            <option value="Information Technology">Information Technology</option>
                            <option value="Business Administration">Business Administration</option>
                            <option value="Mathematics">Mathematics</option>
                        </select>
                    </div>

                    <div class="form-group full-width">
                        <label>Batch / Academic Year</label>
                        <input type="text" asp-for="Batch" placeholder="e.g. 2022-2026" required>
                    </div>

                </div>

                <button type="submit" class="register-btn">Create Account</button>

                <div class="back-link">
                    Already have an account?
                    <a asp-controller="Account" asp-action="Login">Sign In here</a>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Find all inputs and selects in the form
            const inputs = document.querySelectorAll('input, select');
            const registerBtn = document.querySelector('.register-btn');
            const form = document.querySelector('form');

            // 1. Interactive focus effect (just like your login page)
            inputs.forEach(input => {
                input.addEventListener('focus', () => {
                    // Slides the entire input container slightly to the right
                    input.parentElement.style.transform = 'translateX(5px)';
                });

                input.addEventListener('blur', () => {
                    input.parentElement.style.transform = 'translateX(0)';
                });
            });

            // 2. Button authentication state animation on submit
            form.addEventListener('submit', function() {
                registerBtn.innerHTML = 'Creating Account...';
                registerBtn.style.opacity = '0.7';
                registerBtn.style.pointerEvents = 'none';
                registerBtn.style.transform = 'scale(0.98)';
            });
        });
    </script>
</body>
</html>