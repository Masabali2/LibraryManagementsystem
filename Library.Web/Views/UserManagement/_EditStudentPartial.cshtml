@model Library.Domain.Entities.Student

@{
    var firstLetter = !string.IsNullOrWhiteSpace(Model?.StudentName)
        ? Model.StudentName.Substring(0, 1).ToUpper()
        : "S";
}

<style>
    .edit-avatar {
        width: 82px;
        height: 82px;
        color: white;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 800;
        background: linear-gradient(135deg, #2563eb, #9333ea);
        overflow: hidden;
        border: 3px solid #edf2f7;
        flex-shrink: 0;
    }

        .edit-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .edit-form-label {
        font-weight: 700;
        font-size: .82rem;
        color: #334155;
    }

    .btn-update {
        min-width: 150px;
        padding: 10px 30px;
        border-radius: 50px;
        font-weight: 700;
    }
</style>

<form id="editStudentForm" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="StudentId" />
    <input type="hidden" asp-for="PasswordHash" />
    <input type="hidden" asp-for="Role" />
    <input type="hidden" asp-for="ImageUrl" />
    <input type="hidden" asp-for="IsBanned" />
    <input type="hidden" asp-for="BanReason" />

    <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
        <div class="edit-avatar">
            @if (!string.IsNullOrWhiteSpace(Model?.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="Student profile picture" id="adminStudentPreview" />
            }
            else
            {
                <span>@firstLetter</span>
            }
        </div>

        <div class="flex-grow-1">
            <label class="form-label edit-form-label">Update Student Picture</label>

            <input type="file"
                   name="profileImageFile"
                   class="form-control"
                   accept=".jpg,.jpeg,.png"
                   onchange="previewAdminStudentImage(this)" />

            <small class="text-muted">Accepted formats: JPG, JPEG, PNG.</small>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="StudentName" class="form-label edit-form-label">Full Name</label>
            <input asp-for="StudentName" class="form-control" required />
        </div>

        <div class="col-md-6">
            <label asp-for="Username" class="form-label edit-form-label">Username</label>
            <input asp-for="Username" class="form-control" required />
        </div>

        <div class="col-md-6">
            <label asp-for="Email" class="form-label edit-form-label">Email</label>
            <input asp-for="Email" type="email" class="form-control" required />
        </div>

        <div class="col-md-6">
            <label asp-for="PhoneNumber" class="form-label edit-form-label">Phone Number</label>
            <input asp-for="PhoneNumber" class="form-control" />
        </div>

        <div class="col-md-6">
            <label asp-for="RollNo" class="form-label edit-form-label">Roll Number</label>
            <input asp-for="RollNo" class="form-control" required />
        </div>

        <div class="col-md-6">
            <label asp-for="Batch" class="form-label edit-form-label">Batch</label>
            <input asp-for="Batch" class="form-control" required />
        </div>

        <div class="col-md-12">
            <label asp-for="Department" class="form-label edit-form-label">Department</label>
            <input asp-for="Department" class="form-control" required />
        </div>
    </div>

    <div class="d-flex justify-content-center gap-3 mt-4 pt-2 border-top">
        <button type="button"
                class="btn btn-light border rounded-pill px-4"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit" class="btn btn-primary rounded-pill btn-update">
            <i class="fas fa-save me-1"></i> Update Student
        </button>
    </div>
</form>