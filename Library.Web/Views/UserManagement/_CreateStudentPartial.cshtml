@model Library.Domain.Entities.Student

<style>
    .create-avatar {
        width: 82px;
        height: 82px;
        color: white;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 800;
        background: linear-gradient(135deg, #2563eb, #9333ea);
        overflow: hidden;
        border: 3px solid #edf2f7;
        flex-shrink: 0;
    }

        .create-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .create-form-label {
        font-weight: 700;
        font-size: .82rem;
        color: #334155;
    }

    .btn-create-student {
        min-width: 160px;
        padding: 10px 30px;
        border-radius: 50px;
        font-weight: 700;
    }
</style>

<form id="createStudentForm" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Role" value="Student" />
    <input type="hidden" asp-for="IsBanned" value="false" />
    <input type="hidden" asp-for="ImageUrl" value="" />

    <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
        <div class="create-avatar">
            <span id="createStudentInitial">S</span>
        </div>

        <div class="flex-grow-1">
            <label class="form-label create-form-label">Upload Student Picture</label>

            <input type="file"
                   name="profileImageFile"
                   class="form-control"
                   accept=".jpg,.jpeg,.png"
                   onchange="previewCreateStudentImage(this)" />

            <small class="text-muted">Accepted formats: JPG, JPEG, PNG.</small>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="StudentName" class="form-label create-form-label">Full Name</label>
            <input asp-for="StudentName"
                   id="createStudentName"
                   class="form-control"
                   placeholder="Enter full name"
                   required />
        </div>

        <div class="col-md-6">
            <label asp-for="Username" class="form-label create-form-label">Username</label>
            <input asp-for="Username"
                   class="form-control"
                   placeholder="Enter username"
                   required />
        </div>

        <div class="col-md-6">
            <label asp-for="Email" class="form-label create-form-label">Email</label>
            <input asp-for="Email"
                   type="email"
                   class="form-control"
                   placeholder="student@example.com"
                   required />
        </div>

        <div class="col-md-6">
            <label asp-for="PhoneNumber" class="form-label create-form-label">Phone Number</label>
            <input asp-for="PhoneNumber"
                   class="form-control"
                   placeholder="03XX-XXXXXXX" />
        </div>

        <div class="col-md-6">
            <label asp-for="RollNo" class="form-label create-form-label">Roll Number</label>
            <input asp-for="RollNo"
                   class="form-control"
                   placeholder="Example: 22101002-001"
                   required />
        </div>

        <div class="col-md-6">
            <label asp-for="Batch" class="form-label create-form-label">Batch</label>
            <input asp-for="Batch"
                   class="form-control"
                   placeholder="Example: Fall 2024"
                   required />
        </div>

        <div class="col-md-12">
            <label asp-for="Department" class="form-label create-form-label">Department</label>
            <input asp-for="Department"
                   class="form-control"
                   placeholder="Example: Computer Science"
                   required />
        </div>

        <div class="col-md-6">
            <label asp-for="PasswordHash" class="form-label create-form-label">Password</label>
            <input name="password"
                   type="password"
                   class="form-control"
                   placeholder="Create a password"
                   required />
        </div>

        <div class="col-md-6">
            <label class="form-label create-form-label">Confirm Password</label>
            <input name="confirmPassword"
                   type="password"
                   class="form-control"
                   placeholder="Re-enter password"
                   required />
        </div>
    </div>

    <div class="d-flex justify-content-center gap-3 mt-4 pt-2 border-top">
        <button type="button"
                class="btn btn-light border rounded-pill px-4"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit" class="btn btn-primary rounded-pill btn-create-student">
            <i class="fas fa-user-plus me-1"></i> Create Student
        </button>
    </div>
</form>