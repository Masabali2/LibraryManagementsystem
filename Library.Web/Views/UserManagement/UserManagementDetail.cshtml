@model Library.Domain.Entities.Student

@{
    var firstLetter = !string.IsNullOrWhiteSpace(Model.StudentName)
        ? Model.StudentName.Substring(0, 1).ToUpper()
        : "S";

    var borrowedBooksCount = ViewBag.BorrowedBooksCount ?? 0;
}

<style>
    .student-modal-cover {
        height: 115px;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
    }

    .student-modal-avatar {
        width: 82px;
        height: 82px;
        margin: -42px auto 10px;
        border: 4px solid white;
        border-radius: 20px;
        background: #eef2ff;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 800;
        color: #4338ca;
    }

        .student-modal-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .student-info-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 13px;
        height: 100%;
    }

    .student-info-label {
        font-size: .7rem;
        color: #64748b;
        font-weight: 800;
        text-transform: uppercase;
    }

    .student-info-value {
        color: #0f172a;
        font-weight: 750;
        margin-top: 4px;
        overflow-wrap: anywhere;
    }
</style>

<div class="student-modal-cover"></div>

<div class="px-4 pb-4">
    <div class="student-modal-avatar">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.StudentName" />
        }
        else
        {
            <span>@firstLetter</span>
        }
    </div>

    <div class="text-center mb-4">
        <h4 class="fw-bold mb-1">@Model.StudentName</h4>
        <div class="text-muted">@Model.RollNo · @Model.Department</div>

        <span class="badge @(Model.IsBanned ? "bg-danger" : "bg-success") rounded-pill mt-2 px-3">
            @(Model.IsBanned ? "Banned" : "Active Student")
        </span>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="student-info-box">
                <div class="student-info-label">Username</div>
                <div class="student-info-value">@Model.Username</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="student-info-box">
                <div class="student-info-label">Email</div>
                <div class="student-info-value">@Model.Email</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="student-info-box">
                <div class="student-info-label">Phone Number</div>
                <div class="student-info-value">@Model.PhoneNumber</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="student-info-box">
                <div class="student-info-label">Batch</div>
                <div class="student-info-value">@Model.Batch</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="student-info-box">
                <div class="student-info-label">Borrowed / Issued Books</div>
                <div class="student-info-value">@borrowedBooksCount</div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="student-info-box">
                <div class="student-info-label">Account Status</div>
                <div class="student-info-value">
                    @(Model.IsBanned? Model.BanReason: "No restrictions")
                </div>
            </div>
        </div>
    </div>

</div>