@model List<Library.Domain.Entities.Challan>

@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "My Challans";
}

<div class="container py-4">
    <h3 class="fw-bold mb-3">
        <i class="fas fa-file-invoice-dollar text-primary me-2"></i>
        My Challans
    </h3>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Challan No</th>
                        <th>Issue Date</th>
                        <th>Due Date</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th>Print</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var challan in Model)
                    {
                        <tr>
                            <td class="fw-bold">@challan.ChallanNo</td>
                            <td>@challan.IssueDate.ToString("dd MMM yyyy")</td>
                            <td>@challan.DueDate.ToString("dd MMM yyyy")</td>
                            <td>Rs. @challan.TotalAmount.ToString("N2")</td>
                            <td>
                                <span class="badge @(challan.Status == "Paid" ? "bg-success" : "bg-danger")">
                                    @challan.Status
                                </span>
                            </td>
                            <td>
                                <a href="/Challan/StudentPrint?id=@challan.ChallanId"
                                   target="_blank"
                                   class="btn btn-sm btn-primary rounded-pill">
                                    <i class="fas fa-print me-1"></i> Print
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No challans have been generated for you yet.
        </div>
    }
</div>
@await Html.PartialAsync("_LibraryChatbot")