@model Library.Domain.DTOs.CreateChallanDto

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Generate Challan";
    ViewData["ActivePage"] = "Revenue Tracking";
}

<style>
    .challan-page {
        padding: 24px;
    }

    .challan-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 12px 35px rgba(15, 23, 42, 0.06);
    }

    .section-title {
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 16px;
    }

    .form-label {
        font-weight: 700;
        font-size: .85rem;
        color: #334155;
    }

    .readonly-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 10px 14px;
        font-weight: 700;
        color: #0f172a;
    }

    .charge-table th {
        font-size: .78rem;
        text-transform: uppercase;
        color: #64748b;
    }

    .total-box {
        background: linear-gradient(135deg, #2563eb, #9333ea);
        color: white;
        border-radius: 18px;
        padding: 18px;
        text-align: right;
    }

        .total-box h3 {
            font-weight: 900;
            margin: 0;
        }

    .btn-rounded {
        border-radius: 999px;
        font-weight: 700;
        padding: 10px 26px;
    }
</style>

<div class="challan-page">
    <div class="challan-card">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1">
                    <i class="fas fa-file-invoice-dollar text-primary me-2"></i>
                    Generate Challan
                </h3>
                <p class="text-muted mb-0">Create fine, book sale, or library payment voucher.</p>
            </div>

            <a href="/UserManagement" class="btn btn-light border btn-rounded">
                <i class="fas fa-arrow-left me-1"></i> Back
            </a>
        </div>

        <form id="challanForm" method="post" action="/Challan/Generate">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="alert alert-danger"></div>

            <input type="hidden" asp-for="StudentId" />

            <!-- STUDENT INFO -->
            <h5 class="section-title">Student Information</h5>

            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <label class="form-label">Full Name</label>
                    <div class="readonly-box">@Model.StudentName</div>
                    <input type="hidden" asp-for="StudentName" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Roll Number</label>
                    <div class="readonly-box">@Model.RollNo</div>
                    <input type="hidden" asp-for="RollNo" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Department</label>
                    <div class="readonly-box">@Model.Department</div>
                    <input type="hidden" asp-for="Department" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Batch</label>
                    <div class="readonly-box">@Model.Batch</div>
                    <input type="hidden" asp-for="Batch" />
                </div>
            </div>

            <!-- CHALLAN INFO -->
            <h5 class="section-title">Challan Details</h5>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="IssueDate" class="form-label">Issue Date</label>
                    <input asp-for="IssueDate" type="date" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label asp-for="DueDate" class="form-label">Due Date</label>
                    <input asp-for="DueDate" type="date" class="form-control" required />
                </div>

                <div class="col-md-4">
                    <label asp-for="Status" class="form-label">Payment Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Unpaid">Unpaid</option>
                        <option value="Paid">Paid</option>
                        <option value="Partially Paid">Partially Paid</option>
                    </select>
                </div>
            </div>

            <!-- BANK INFO -->
            <h5 class="section-title">Bank Information</h5>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="BankName" class="form-label">Bank Name</label>
                    <input asp-for="BankName" class="form-control" placeholder="Example: Bank of Punjab" required />
                </div>

                <div class="col-md-4">
                    <label asp-for="AccountTitle" class="form-label">Account Title</label>
                    <input asp-for="AccountTitle" class="form-control" placeholder="Example: USKT Library" required />
                </div>

                <div class="col-md-4">
                    <label asp-for="AccountNo" class="form-label">Account Number</label>
                    <input asp-for="AccountNo" class="form-control" placeholder="0000-0000-0000-0000" required />
                </div>
            </div>

            <!-- BOOK INFO -->
            <h5 class="section-title">Book Information</h5>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="BorrowedBooksCount" class="form-label">Borrowed Books</label>
                    <input asp-for="BorrowedBooksCount" type="number" min="0" class="form-control" readonly />
                </div>

                <div class="col-md-4">
                    <label asp-for="IssuedBooksCount" class="form-label">Issued Books</label>
                    <input asp-for="IssuedBooksCount" type="number" min="0" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label asp-for="PurchasedBooksCount" class="form-label">Purchased Books</label>
                    <input asp-for="PurchasedBooksCount" type="number" min="0" class="form-control" />
                </div>
            </div>

            <!-- CHARGES -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="section-title mb-0">Charges</h5>

                <button type="button" class="btn btn-primary btn-rounded" onclick="addChargeRow()">
                    <i class="fas fa-plus me-1"></i> Add Charge Row
                </button>
            </div>

            <div class="table-responsive mb-4">
                <table class="table charge-table align-middle" id="chargesTable">
                    <thead>
                        <tr>
                            <th style="width: 35%;">Particulars</th>
                            <th style="width: 15%;">Quantity</th>
                            <th style="width: 20%;">Unit Price</th>
                            <th style="width: 20%;">Amount</th>
                            <th style="width: 10%;" class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody id="chargesBody">
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            <tr>
                                <td>
                                    <input name="Items[@i].Particulars"
                                           class="form-control particulars"
                                           value="@Model.Items[i].Particulars"
                                           required />
                                </td>

                                <td>
                                    <input name="Items[@i].Quantity"
                                           type="number"
                                           min="1"
                                           value="@Model.Items[i].Quantity"
                                           class="form-control quantity"
                                           oninput="calculateTotals()"
                                           required />
                                </td>

                                <td>
                                    <input name="Items[@i].UnitPrice"
                                           type="number"
                                           min="0"
                                           step="0.01"
                                           value="@Model.Items[i].UnitPrice"
                                           class="form-control unit-price"
                                           oninput="calculateTotals()"
                                           required />
                                </td>

                                <td>
                                    <input name="Items[@i].Amount"
                                           type="number"
                                           value="@Model.Items[i].Amount"
                                           class="form-control amount"
                                           readonly />
                                </td>

                                <td class="text-center">
                                    <button type="button"
                                            class="btn btn-sm btn-danger rounded-circle"
                                            onclick="removeChargeRow(this)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- NOTES AND TOTAL -->
            <div class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label asp-for="Notes" class="form-label">Extra Information / Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="4"
                              placeholder="Example: Payment must be submitted before due date. Keep this challan for record."></textarea>
                </div>

                <div class="col-md-4">
                    <div class="total-box">
                        <div class="small">Total Amount</div>
                        <h3>Rs. <span id="grandTotal">0</span></h3>
                        <input asp-for="TotalAmount" type="hidden" id="TotalAmount" />
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3 mt-4 pt-3 border-top">
                <button type="reset" class="btn btn-light border btn-rounded">
                    Reset
                </button>

                <button type="submit" class="btn btn-success btn-rounded">
                    <i class="fas fa-file-invoice me-1"></i> Generate Challan
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let rowIndex = 1;

        function addChargeRow() {
            const tbody = document.getElementById("chargesBody");

            const row = document.createElement("tr");

            row.innerHTML = `
                <td>
                    <select name="Items[${rowIndex}].Particulars" class="form-select particulars" required>
                        <option value="">Select Charge</option>
                        <option value="Late Fine">Late Fine</option>
                        <option value="Lost Book Fine">Lost Book Fine</option>
                        <option value="Book Purchase">Book Purchase</option>
                        <option value="Library Development Fund">Library Development Fund</option>
                        <option value="Service Charges">Service Charges</option>
                        <option value="ID Card Fee">ID Card Fee</option>
                    </select>
                </td>

                <td>
                    <input name="Items[${rowIndex}].Quantity" type="number" min="1" value="1"
                           class="form-control quantity" oninput="calculateTotals()" required />
                </td>

                <td>
                    <input name="Items[${rowIndex}].UnitPrice" type="number" min="0" value="0"
                           class="form-control unit-price" oninput="calculateTotals()" required />
                </td>

                <td>
                    <input name="Items[${rowIndex}].Amount" type="number" value="0"
                           class="form-control amount" readonly />
                </td>

                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-danger rounded-circle" onclick="removeChargeRow(this)">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(row);
            rowIndex++;
            calculateTotals();
        }

        function removeChargeRow(button) {
            const tbody = document.getElementById("chargesBody");

            if (tbody.rows.length === 1) {
                alert("At least one charge row is required.");
                return;
            }

            button.closest("tr").remove();
            reIndexRows();
            calculateTotals();
        }

        function reIndexRows() {
            const rows = document.querySelectorAll("#chargesBody tr");

            rows.forEach((row, index) => {
                row.querySelector(".particulars").setAttribute("name", `Items[${index}].Particulars`);
                row.querySelector(".quantity").setAttribute("name", `Items[${index}].Quantity`);
                row.querySelector(".unit-price").setAttribute("name", `Items[${index}].UnitPrice`);
                row.querySelector(".amount").setAttribute("name", `Items[${index}].Amount`);
            });

            rowIndex = rows.length;
        }

        function calculateTotals() {
            let grandTotal = 0;

            document.querySelectorAll("#chargesBody tr").forEach(row => {
                const quantity = parseFloat(row.querySelector(".quantity").value) || 0;
                const unitPrice = parseFloat(row.querySelector(".unit-price").value) || 0;
                const amount = quantity * unitPrice;

                row.querySelector(".amount").value = amount.toFixed(2);
                grandTotal += amount;
            });

            document.getElementById("grandTotal").innerText = grandTotal.toFixed(2);
            document.getElementById("TotalAmount").value = grandTotal.toFixed(2);
        }

        document.addEventListener("DOMContentLoaded", calculateTotals);
    </script>
}