@model Library.Domain.Entities.Challan

@{
    ViewData["Title"] = "Challan Details";
    Layout = "_AdminLayout";

    var statusClass = Model.Status switch
    {
        "Paid" => "bg-success",
        "Partially Paid" => "bg-warning text-dark",
        "Cancelled" => "bg-secondary",
        _ => "bg-danger"
    };
}

<style>
    .challan-details-page {
        padding: 24px;
    }

    .challan-details-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 12px 35px rgba(15, 23, 42, .06);
    }

    .challan-title {
        color: #0f172a;
        font-weight: 850;
    }

    .info-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 13px;
        height: 100%;
    }

    .info-label {
        color: #64748b;
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .04em;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .info-value {
        color: #0f172a;
        font-size: .95rem;
        font-weight: 750;
        word-break: break-word;
    }

    .section-heading {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 850;
        margin: 26px 0 14px;
    }

    .summary-card {
        border-radius: 16px;
        padding: 16px;
        color: #fff;
        height: 100%;
    }

        .summary-card.borrowed {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
        }

        .summary-card.issued {
            background: linear-gradient(135deg, #7c3aed, #5b21b6);
        }

        .summary-card.purchased {
            background: linear-gradient(135deg, #059669, #047857);
        }

        .summary-card.total {
            background: linear-gradient(135deg, #ea580c, #c2410c);
        }

    .summary-label {
        font-size: .75rem;
        font-weight: 700;
        opacity: .9;
    }

    .summary-value {
        font-size: 1.65rem;
        font-weight: 900;
        margin-top: 3px;
    }

    .charge-table th {
        background: #f1f5f9;
        color: #475569;
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .charge-table td,
    .charge-table th {
        padding: 12px;
        vertical-align: middle;
    }

    .total-row td {
        background: #f8fafc;
        font-size: 1rem;
        font-weight: 850;
    }

    .notes-box {
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 14px;
        padding: 14px;
        color: #78350f;
    }

    .btn-rounded {
        border-radius: 999px;
        font-weight: 750;
        padding: 9px 20px;
    }
</style>

<div class="challan-details-page">
    <div class="challan-details-card">

        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 border-bottom pb-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h3 class="challan-title mb-0">
                        <i class="fas fa-file-invoice-dollar text-primary me-2"></i>
                        Challan Details
                    </h3>

                    <span class="badge @statusClass rounded-pill px-3 py-2">
                        @Model.Status
                    </span>
                </div>

                <p class="text-muted mb-0 mt-1">
                    Challan No:
                    <strong class="text-dark">@Model.ChallanNo</strong>
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a href="/Challan/List" class="btn btn-light border btn-rounded">
                    <i class="fas fa-arrow-left me-1"></i> All Challans
                </a>

                <a href="/Challan/Print/@Model.ChallanId"
                   target="_blank"
                   class="btn btn-primary btn-rounded">
                    <i class="fas fa-print me-1"></i> Print Challan
                </a>

                <button type="button"
                        class="btn btn-danger btn-rounded"
                        onclick="deleteChallan(@Model.ChallanId)">
                    <i class="fas fa-trash me-1"></i> Delete
                </button>
            </div>
        </div>

        <h5 class="section-heading">Student Information</h5>

        <div class="row g-3">
            <div class="col-md-3">
                <div class="info-box">
                    <div class="info-label">Student Name</div>
                    <div class="info-value">@Model.Student?.StudentName</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="info-box">
                    <div class="info-label">Roll Number</div>
                    <div class="info-value">@Model.Student?.RollNo</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="info-box">
                    <div class="info-label">Department</div>
                    <div class="info-value">@Model.Student?.Department</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="info-box">
                    <div class="info-label">Batch</div>
                    <div class="info-value">@Model.Student?.Batch</div>
                </div>
            </div>
        </div>

        <h5 class="section-heading">Challan and Bank Information</h5>

        <div class="row g-3">
            <div class="col-md-3">
                <div class="info-box">
                    <div class="info-label">Issue Date</div>
                    <div class="info-value">@Model.IssueDate.ToString("dd MMM yyyy")</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="info-box">
                    <div class="info-label">Due Date</div>
                    <div class="info-value">@Model.DueDate.ToString("dd MMM yyyy")</div>
                </div>
            </div>

            <div class="col-md-2">
                <div class="info-box">
                    <div class="info-label">Bank Name</div>
                    <div class="info-value">@Model.BankName</div>
                </div>
            </div>

            <div class="col-md-2">
                <div class="info-box">
                    <div class="info-label">Account Title</div>
                    <div class="info-value">@Model.AccountTitle</div>
                </div>
            </div>

            <div class="col-md-2">
                <div class="info-box">
                    <div class="info-label">Account Number</div>
                    <div class="info-value">@Model.AccountNo</div>
                </div>
            </div>
        </div>

        <h5 class="section-heading">Library Book Summary</h5>

        <div class="row g-3">
            <div class="col-md-3">
                <div class="summary-card borrowed">
                    <div class="summary-label">Borrowed Books</div>
                    <div class="summary-value">@Model.BorrowedBooksCount</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card issued">
                    <div class="summary-label">Issued Books</div>
                    <div class="summary-value">@Model.IssuedBooksCount</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card purchased">
                    <div class="summary-label">Purchased Books</div>
                    <div class="summary-value">@Model.PurchasedBooksCount</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="summary-card total">
                    <div class="summary-label">Total Amount</div>
                    <div class="summary-value">Rs. @Model.TotalAmount.ToString("N2")</div>
                </div>
            </div>
        </div>

        <h5 class="section-heading">Charge Details</h5>

        <div class="table-responsive">
            <table class="table table-bordered charge-table mb-0">
                <thead>
                    <tr>
                        <th style="width: 8%;">#</th>
                        <th>Particulars</th>
                        <th style="width: 14%;" class="text-center">Quantity</th>
                        <th style="width: 18%;" class="text-end">Unit Price</th>
                        <th style="width: 20%;" class="text-end">Amount</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        var number = 1;
                    }

                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@number</td>
                                <td class="fw-semibold">@item.Particulars</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">Rs. @item.UnitPrice.ToString("N2")</td>
                                <td class="text-end fw-bold">Rs. @item.Amount.ToString("N2")</td>
                            </tr>

                            number++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                No charges were added to this challan.
                            </td>
                        </tr>
                    }

                    <tr class="total-row">
                        <td colspan="4" class="text-end">Grand Total</td>
                        <td class="text-end">Rs. @Model.TotalAmount.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <h5 class="section-heading">Extra Information</h5>

            <div class="notes-box">
                <i class="fas fa-circle-info me-1"></i>
                @Model.Notes
            </div>
        }

        <h5 class="section-heading">Payment Status</h5>

        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-bold">Change Status</label>

                <select id="challanStatus" class="form-select">
                    <option value="Unpaid" selected="@(Model.Status == "Unpaid")">Unpaid</option>
                    <option value="Partially Paid" selected="@(Model.Status == "Partially Paid")">Partially Paid</option>
                    <option value="Paid" selected="@(Model.Status == "Paid")">Paid</option>
                    <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>

            <div class="col-md-3">
                <button type="button"
                        class="btn btn-success btn-rounded w-100"
                        onclick="updateChallanStatus(@Model.ChallanId)">
                    <i class="fas fa-check-circle me-1"></i> Update Status
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function updateChallanStatus(challanId) {
            const status = document.getElementById("challanStatus").value;

            try {
                const response = await fetch("/Challan/UpdateStatus", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: new URLSearchParams({
                        challanId: challanId,
                        status: status
                    })
                });

                const result = await response.json();

                if (!result.success) {
                    alert("Unable to update challan status.");
                    return;
                }

                window.location.reload();
            } catch (error) {
                alert("Network error: " + error.message);
            }
        }

        async function deleteChallan(challanId) {
            const confirmed = confirm(
                "Are you sure you want to delete this challan? This action cannot be undone."
            );

            if (!confirmed) {
                return;
            }

            try {
                const response = await fetch("/Challan/Delete", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: new URLSearchParams({
                        challanId: challanId
                    })
                });

                const result = await response.json();

                if (!result.success) {
                    alert("Unable to delete challan.");
                    return;
                }

                window.location.href = "/Challan/List";
            } catch (error) {
                alert("Network error: " + error.message);
            }
        }
    </script>
}