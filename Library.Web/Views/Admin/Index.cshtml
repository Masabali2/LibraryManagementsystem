@model Library.Web.ViewModels.AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["ActivePage"] = "Dashboard";
}

<style>
    .welcome-banner {
        background: var(--primary-grad);
        padding: 40px;
        border-radius: 30px;
        color: white;
        margin-bottom: 40px;
        position: relative;
        overflow: hidden;
    }

        .welcome-banner::after {
            content: '';
            position: absolute;
            top: -50px;
            right: -50px;
            width: 200px;
            height: 200px;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
        }

    .stat-card {
        background: white;
        border-radius: 24px;
        padding: 25px;
        border: none;
        transition: 0.3s;
        height: 100%;
    }

        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.05);
        }

    .icon-circle {
        width: 50px;
        height: 50px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin-bottom: 20px;
    }
</style>

<div class="welcome-banner">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="fw-bold">Welcome back, Innam Qureshi! ✨</h1>
            <p class="opacity-75 mb-0">The system is currently handling @Model.ActiveStudents active readers and @Model.TotalBooks library items.</p>
        </div>
        <div class="col-md-4 text-end d-none d-md-block">
            <button class="btn btn-light rounded-pill px-4 py-2 fw-bold">View Reports</button>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="icon-circle" style="background: #eef2ff; color: #6366f1;">📚</div>
            <h2 class="fw-bold">@Model.TotalBooks</h2>
            <p class="text-muted small mb-0">Library Inventory</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="icon-circle" style="background: #f0fdf4; color: #22c55e;">👥</div>
            <h2 class="fw-bold">@Model.ActiveStudents</h2>
            <p class="text-muted small mb-0">Active Students</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="icon-circle" style="background: #fffbeb; color: #f59e0b;">📤</div>
            <h2 class="fw-bold">@Model.BooksIssuedToday</h2>
            <p class="text-muted small mb-0">Issued Today</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="icon-circle" style="background: #fef2f2; color: #ef4444;">⚠️</div>
            <h2 class="fw-bold">@Model.OverdueReturns</h2>
            <p class="text-muted small mb-0">Overdue Alerts</p>
        </div>
    </div>
</div>

<div class="mt-5 bg-white p-4 rounded-4 shadow-sm border-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold">Live Activity Feed</h5>
        <a href="#" class="btn btn-link text-decoration-none p-0">View All</a>
    </div>
    <div class="table-responsive">
        <table class="table align-middle border-0">
            <thead class="bg-light">
                <tr>
                    <th class="border-0 rounded-start">Student</th>
                    <th class="border-0">Item ID</th>
                    <th class="border-0">Date</th>
                    <th class="border-0 rounded-end">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.RecentTransactions)
                {
                    <tr>
                        <td class="border-0 py-3"><strong>@item.StudentName</strong></td>
                        <td class="border-0 py-3"><span class="badge bg-light text-dark">#@item.BookId</span></td>
                        <td class="border-0 py-3">@item.Date.ToString("MMM dd")</td>
                        <td class="border-0 py-3">
                            <span class="badge @(item.Status == "Returned" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") rounded-pill px-3">
                                @item.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>