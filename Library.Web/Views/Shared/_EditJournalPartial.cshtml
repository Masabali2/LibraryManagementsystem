@model Library.Domain.Entities.Journal

<form asp-action="UpdateJournal" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="JournalId" />

    <input type="hidden" asp-for="ShelfId" />

    <div class="row g-3">
        <div class="col-md-12">
            <label class="form-label small fw-bold text-muted">JOURNAL TITLE</label>
            <input asp-for="JournalName" class="form-control rounded-pill px-3 shadow-sm" required />
        </div>

        <div class="col-md-6">
            <label class="form-label small fw-bold text-muted">PUBLISHER / ISSN</label>
            <input asp-for="Publisher" class="form-control rounded-pill px-3 shadow-sm" />
        </div>
        <div class="col-md-6">
            <label class="form-label small fw-bold text-muted">DEPARTMENT</label>
            <input asp-for="Department" class="form-control rounded-pill px-3 shadow-sm" />
        </div>

        <div class="col-md-6">
            <label class="form-label small fw-bold text-muted">LOCATION BLOCK</label>
            <input name="LocationBlockName" class="form-control rounded-pill px-3 shadow-sm"
                   value="@Model.Shelf?.LocationBlock?.Name" placeholder="e.g. Reference Section" />
        </div>
        <div class="col-md-6">
            <label class="form-label small fw-bold text-muted">SHELF CODE</label>
            <input name="ShelfCode" class="form-control rounded-pill px-3 shadow-sm"
                   value="@Model.Shelf?.ShelfCode" placeholder="e.g. J-Shelf-01" />
        </div>

        <div class="col-md-4">
            <label class="form-label small fw-bold text-muted">VOLUME</label>
            <input asp-for="Volume" class="form-control rounded-pill px-3 shadow-sm" />
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-bold text-muted">YEAR</label>
            <input asp-for="Year" class="form-control rounded-pill px-3 shadow-sm" />
        </div>
    </div>

    <div class="text-end mt-4 pt-3 border-top">
        <button type="button" class="btn btn-light rounded-pill px-4 me-2" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm text-white fw-bold">
            <i class="fas fa-sync-alt me-1"></i> Update Journal
        </button>
    </div>
</form>