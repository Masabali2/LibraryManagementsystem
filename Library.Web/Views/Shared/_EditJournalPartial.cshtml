@model Library.Domain.Entities.Journal

<style>
    .edit-form-container {
        animation: fadeSlideIn 0.4s ease;
    }

    @@keyframes fadeSlideIn {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-card {
        background: rgba(255,255,255,0.75);
        backdrop-filter: blur(10px);
        border-radius: 16px;
        padding: 18px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.05);
    }

    .top-cover-box {
        display: flex;
        align-items: center;
        gap: 16px;
        background: #f8fafc;
        border: 2px dashed #cbd5e1;
        border-radius: 14px;
        padding: 12px;
        margin-bottom: 14px;
    }

    .current-cover-preview {
        width: 90px;
        height: 115px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        box-shadow: 0 4px 10px rgba(0,0,0,0.12);
        flex-shrink: 0;
    }

    .no-cover-preview {
        width: 90px;
        height: 115px;
        border-radius: 12px;
        background: #64748b;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        text-align: center;
        flex-shrink: 0;
    }

    .form-control {
        border-radius: 50px !important;
        border: 1px solid #e2e8f0;
        padding: 9px 14px;
        font-size: 0.9rem;
    }

    textarea.form-control {
        border-radius: 15px !important;
    }

    .form-label {
        font-size: 0.68rem;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }
</style>

<div class="edit-form-container">
    <div class="form-card">

        <form asp-action="UpdateJournal" asp-controller="Inventory" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="JournalId" />
            <input type="hidden" asp-for="ShelfId" />
            <input type="hidden" asp-for="ImageUrl" />

            <div class="top-cover-box">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="Current Journal Cover" class="current-cover-preview" />
                }
                else
                {
                    <div class="no-cover-preview">No Image</div>
                }

                <div class="flex-grow-1">
                    <label class="form-label fw-bold text-muted">JOURNAL COVER IMAGE</label>
                    <input type="file"
                           name="JournalImage"
                           id="EditJournalImageFile"
                           class="form-control shadow-sm"
                           accept="image/*" />
                    <small class="text-muted d-block mt-1 ms-2" style="font-size: 0.68rem;">
                        Leave empty to keep current picture
                    </small>
                </div>
            </div>

            <div class="row g-2">
                <div class="col-md-8">
                    <label class="form-label fw-bold text-muted">JOURNAL TITLE</label>
                    <input asp-for="JournalName" class="form-control shadow-sm" required />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold text-muted">YEAR</label>
                    <input asp-for="Year" class="form-control shadow-sm" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted">PUBLISHER / ISSN</label>
                    <input asp-for="Publisher" class="form-control shadow-sm" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted">DEPARTMENT</label>
                    <input asp-for="Department" class="form-control shadow-sm" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold text-muted">VOLUME</label>
                    <input asp-for="Volume" class="form-control shadow-sm" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold text-muted">LOCATION BLOCK</label>
                    <input name="LocationBlockName"
                           class="form-control shadow-sm"
                           value="@Model.Shelf?.LocationBlock?.Name"
                           placeholder="e.g. Reference Section" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold text-muted">SHELF CODE</label>
                    <input name="ShelfCode"
                           class="form-control shadow-sm"
                           value="@Model.Shelf?.ShelfCode"
                           placeholder="e.g. J-Shelf-01" />
                </div>
            </div>

            <div class="text-end mt-3 pt-3 border-top">
                <button type="button" class="btn btn-light rounded-pill px-4 me-2" data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm text-white fw-bold">
                    <i class="fas fa-sync-alt me-1"></i> Update Journal
                </button>
            </div>
        </form>

    </div>
</div>