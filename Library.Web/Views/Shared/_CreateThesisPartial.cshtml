@model Library.Domain.Entities.Thesis
@{
    var token = Context.RequestServices.GetService<Microsoft.AspNetCore.Antiforgery.IAntiforgery>()?.GetAndStoreTokens(Context).RequestToken;
}
<style>
    /* 🚀 Identical styling configuration to match Book and Journal forms */
    .create-form .form-group {
        margin-bottom: 0.8rem;
    }

    .create-form .form-control, .create-form .form-select {
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        padding: 0.55rem 0.9rem;
        transition: all 0.2s ease-in-out;
        background-color: #f8fafc;
    }

        .create-form .form-control:focus, .create-form .form-select:focus {
            border-color: #3182ce;
            box-shadow: 0 0 0 3px rgba(49,130,206,0.1);
            outline: none;
            background-color: white;
            transform: translateY(-1px);
        }

    .create-form label {
        font-weight: 600;
        font-size: 0.85rem;
        color: #2d3748;
        margin-bottom: 0.25rem;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .create-form label i {
            color: #3182ce;
            font-size: 0.9rem;
        }

    .create-form .btn-submit {
        background: linear-gradient(135deg, #3182ce 0%, #2c5282 100%);
        border: none;
        padding: 0.6rem 1.8rem;
        border-radius: 40px;
        font-weight: 600;
        transition: all 0.2s;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

        .create-form .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(49,130,206,0.3);
            background: linear-gradient(135deg, #2c5282 0%, #1a365d 100%);
        }

    .create-form .btn-cancel {
        border-radius: 40px;
        padding: 0.6rem 1.8rem;
        font-weight: 500;
        transition: all 0.2s;
    }

        .create-form .btn-cancel:hover {
            background-color: #f1f5f9;
            transform: translateY(-1px);
        }

    @@keyframes fadeSlideUp {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .create-form {
        animation: fadeSlideUp 0.3s ease-out;
        max-width: 100%;
    }
</style>

<form method="post" asp-action="CreateThesis" asp-controller="Inventory" id="createThesisForm" class="create-form" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="row g-3">

        <div class="col-md-6 form-group">
            <label><i class="fas fa-heading"></i> Research Title</label>
            <input asp-for="Title" class="form-control" placeholder="Thesis or Project Title" required />
        </div>

        <div class="col-md-6 form-group">
            <label><i class="fas fa-user-graduate"></i> Student Name</label>
            <input asp-for="StudentName" class="form-control" placeholder="Student Name" required />
        </div>

        <div class="col-md-6 form-group">
            <label><i class="fas fa-building"></i> Department</label>
            <input asp-for="Department" class="form-control" placeholder="e.g., Computer Science" required />
        </div>

        <div class="col-md-3 form-group">
            <label><i class="fas fa-id-card"></i> Roll Number</label>
            <input asp-for="RollNo" class="form-control" placeholder="Roll No" required />
        </div>

        <div class="col-md-3 form-group">
            <label><i class="fas fa-layer-group"></i> Batch</label>
            <input asp-for="Batch" class="form-control" placeholder="e.g., 2022-2026" required />
        </div>

        <div class="col-md-3 form-group">
            <label><i class="fas fa-calendar-alt"></i> Submission Year</label>
            <input asp-for="Year" type="number" class="form-control" placeholder="YYYY" required />
        </div>

        <div class="col-md-4 form-group">
            <label><i class="fas fa-map-marker-alt"></i> Location Block Name</label>
            <input name="LocationBlockName" class="form-control" placeholder="e.g., Main Library" />
        </div>

        <div class="col-md-5 form-group">
            <label><i class="fas fa-th"></i> Shelf Code</label>
            <input name="ShelfCode" class="form-control" placeholder="e.g., Cabinet-04" />
        </div>

        <div class="col-md-12 form-group">
            <label><i class="fas fa-image"></i> Thesis Document Image / Cover</label>
            <input type="file" name="ThesisImage" id="ThesisImage" class="form-control" accept="image/*" />
        </div>
    </div>

    <div class="mt-3 text-end d-flex gap-2 justify-content-end">
        <button type="button" class="btn btn-light btn-cancel" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Cancel</button>
        <button type="submit" class="btn btn-primary btn-submit"><i class="fas fa-save me-1"></i> Create Thesis</button>
    </div>
</form>