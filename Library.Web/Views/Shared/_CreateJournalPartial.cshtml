@model Library.Domain.Entities.Journal
@{
    var token = Context.RequestServices.GetService<Microsoft.AspNetCore.Antiforgery.IAntiforgery>()?.GetAndStoreTokens(Context).RequestToken;
}
<style>
    .create-form .form-group {
        margin-bottom: 1rem;
    }

    .create-form .form-control, .create-form .form-select {
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        padding: 0.6rem 1rem;
        transition: all 0.2s ease-in-out;
        background-color: #f8fafc;
    }

        .create-form .form-control:focus, .create-form .form-select:focus {
            border-color: #3182ce;
            box-shadow: 0 0 0 3px rgba(49,130,206,0.1);
            outline: none;
            background-color: white;
            transform: translateY(-1px);
        }

    .create-form label {
        font-weight: 600;
        font-size: 0.85rem;
        color: #2d3748;
        margin-bottom: 0.35rem;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .create-form label i {
            color: #3182ce;
            font-size: 0.9rem;
        }

    .create-form .btn-submit {
        background: linear-gradient(135deg, #3182ce 0%, #2c5282 100%);
        border: none;
        padding: 0.6rem 1.8rem;
        border-radius: 40px;
        font-weight: 600;
        transition: all 0.2s;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

        .create-form .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(49,130,206,0.3);
            background: linear-gradient(135deg, #2c5282 0%, #1a365d 100%);
        }

    .create-form .btn-cancel {
        border-radius: 40px;
        padding: 0.6rem 1.8rem;
        font-weight: 500;
        transition: all 0.2s;
    }

        .create-form .btn-cancel:hover {
            background-color: #f1f5f9;
            transform: translateY(-1px);
        }

    .create-form .row {
        margin-top: 0.5rem;
    }
   @@keyframes fadeSlideUp {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .create-form {
        animation: fadeSlideUp 0.3s ease-out;
    }
</style>

<form method="post" asp-action="CreateJournal" asp-controller="Inventory" id="createJournalForm" class="create-form">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-md-12 form-group">
            <label><i class="fas fa-book-open"></i> Journal Name</label>
            <input asp-for="JournalName" class="form-control" placeholder="e.g., Nature, Science" required />
        </div>
        <div class="col-md-6 form-group">
            <label><i class="fas fa-building"></i> Department</label>
            <input asp-for="Department" class="form-control" placeholder="e.g., Computer Science" />
        </div>
        <div class="col-md-6 form-group">
            <label><i class="fas fa-print"></i> Publisher</label>
            <input asp-for="Publisher" class="form-control" placeholder="Publisher name" />
        </div>
        <div class="col-md-3 form-group">
            <label><i class="fas fa-layer-group"></i> Volume</label>
            <input asp-for="Volume" type="number" class="form-control" placeholder="Vol." />
        </div>
        <div class="col-md-3 form-group">
            <label><i class="fas fa-code-branch"></i> Edition</label>
            <input asp-for="Edition" class="form-control" placeholder="Edition" />
        </div>
        <div class="col-md-3 form-group">
            <label><i class="fas fa-calendar-alt"></i> Year</label>
            <input asp-for="Year" class="form-control" placeholder="YYYY" required />
        </div>
        <div class="col-md-3 form-group">
            <label><i class="fas fa-cubes"></i> Quantity</label>
            <input asp-for="Quantity" type="number" class="form-control" placeholder="Number of copies" />
        </div>
        <div class="col-md-6 form-group">
            <label><i class="fas fa-map-marker-alt"></i> Location Block Name</label>
            <input name="LocationBlockName" class="form-control" placeholder="e.g., Main Library" />
        </div>
        <div class="col-md-6 form-group">
            <label><i class="fas fa-th"></i> Shelf Code</label>
            <input name="ShelfCode" class="form-control" placeholder="e.g., A-12" />
        </div>
    </div>
    <div class="mt-4 text-end d-flex gap-2 justify-content-end">
        <button type="button" class="btn btn-light btn-cancel" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i> Cancel</button>
        <button type="submit" class="btn btn-primary btn-submit"><i class="fas fa-save me-1"></i> Create Journal</button>
    </div>
</form>