@model Library.Domain.Entities.Book

<style>
    /* 🌟 Form Container Animation */
    .edit-form-container {
        animation: fadeSlideIn 0.4s ease;
    }

    @@keyframes fadeSlideIn {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ✨ Input Styling */
    .form-control {
        border-radius: 50px !important;
        border: 1px solid #e2e8f0;
        transition: all 0.25s ease;
        padding: 10px 15px;
    }

        .form-control:focus {
            border-color: #3182ce;
            box-shadow: 0 0 0 3px rgba(49,130,206,0.15);
            transform: scale(1.02);
        }

    /* 🏷 Labels */
    .form-label {
        font-size: 0.7rem;
        letter-spacing: 0.5px;
    }

    /* 🎯 Section Divider */
    .form-section {
        border-bottom: 1px dashed #e2e8f0;
        padding-bottom: 10px;
        margin-bottom: 10px;
    }

    /* 🔘 Buttons */
    .btn-primary {
        background: linear-gradient(135deg, #3182ce, #00c6ff);
        border: none;
        transition: 0.3s;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(49,130,206,0.3);
        }

    .btn-light {
        background: #f1f5f9;
    }

    /* 📦 Card Feel */
    .form-card {
        background: rgba(255,255,255,0.7);
        backdrop-filter: blur(10px);
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.05);
    }
</style>

<div class="edit-form-container">
    <div class="form-card">

        <form asp-action="UpdateBook" asp-controller="Inventory" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <input type="hidden" asp-for="BookId" />
            <input type="hidden" asp-for="ShelfId" />

            <div class="row g-3">

                <!-- 📘 BASIC INFO -->
                <div class="col-md-12 form-section">
                    <label class="form-label fw-bold text-muted">BOOK TITLE</label>
                    <input asp-for="Title" class="form-control shadow-sm" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted">AUTHOR</label>
                    <input asp-for="Author" class="form-control shadow-sm" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted">DEPARTMENT</label>
                    <input asp-for="Department" class="form-control shadow-sm" required />
                </div>

                <!-- 📍 LOCATION -->
                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted">LOCATION BLOCK</label>
                    <input name="LocationBlockName"
                           value="@Model.Shelf?.LocationBlock?.Name"
                           class="form-control shadow-sm"
                           placeholder="e.g. Main Library" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted">SHELF CODE</label>
                    <input name="ShelfCode"
                           value="@Model.Shelf?.ShelfCode"
                           class="form-control shadow-sm"
                           placeholder="e.g. Row-01" />
                </div>

                <!-- 📅 YEAR -->
                <div class="col-md-12">
                    <label class="form-label fw-bold text-muted">PUBLICATION YEAR</label>
                    <input asp-for="PublicationYear" type="number"
                           class="form-control shadow-sm" />
                </div>

                <!-- 📊 STOCK -->
                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted">TOTAL COPIES</label>
                    <input asp-for="TotalCopies" type="number" min="0"
                           class="form-control shadow-sm" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted">AVAILABLE COPIES</label>
                    <input asp-for="AvailableCopies" type="number" min="0"
                           class="form-control shadow-sm" />
                </div>

            </div>

            <!-- ACTIONS -->
            <div class="text-end mt-4 pt-3 border-top">
                <button type="button"
                        class="btn btn-light rounded-pill px-4 me-2"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="submit"
                        class="btn btn-primary rounded-pill px-4 fw-bold">
                    <i class="fas fa-save me-1"></i> Update Record
                </button>
            </div>

        </form>

    </div>
</div>

<script>
    // 🔥 Smart validation: Available <= Total
    document.addEventListener('input', function (e) {
        if (e.target.name.includes('AvailableCopies')) {
            const total = document.querySelector('[name="TotalCopies"]')?.value;
            if (total && parseInt(e.target.value) > parseInt(total)) {
                e.target.value = total;
            }
        }
    });
</script>