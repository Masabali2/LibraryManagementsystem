@model Library.Web.ViewModels.MyBooksViewModel
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "My Books";
    ViewData["ActivePage"] = "MyBooks";
}

@section Styles {
    <style>
        /* PAGE HEADER */
        .page-header {
            margin-bottom: 30px;
            animation: fadeInDown 0.6s ease-out;
        }

            .page-header h1 {
                font-size: 28px;
                color: #1a202c;
                font-weight: 700;
                margin-bottom: 5px;
            }

            .page-header p {
                color: #718096;
                font-size: 15px;
            }

        /* TABS NAVIGATION */
        .tabs-nav {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 30px;
            border-bottom: 1px solid #edf2f7;
            padding-bottom: 15px;
            flex-wrap: wrap;
        }

        .tab-btn {
            background: none;
            border: none;
            padding: 10px 20px;
            font-size: 14px;
            font-weight: 600;
            color: #718096;
            cursor: pointer;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .tab-btn.active {
                background-color: #6b46c1;
                color: #ffffff;
            }

            .tab-btn:hover:not(.active) {
                background-color: #f7fafc;
                color: #2d3748;
            }

        .filter-divider {
            width: 1px;
            height: 24px;
            background-color: #e2e8f0;
            margin: 0 10px;
        }

        /* BOOK GRID & CARDS */
        .books-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 25px;
            animation: fadeInUp 0.8s ease-out;
        }

        .book-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            border: 1px solid #edf2f7;
            transition: all 0.3s ease;
        }

            .book-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
                border-color: #e2e8f0;
            }

        .book-title {
            font-size: 18px;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 5px;
        }

        .book-author {
            font-size: 14px;
            color: #718096;
            margin-bottom: 15px;
        }

        /* PROGRESS BAR */
        .progress-container {
            margin-bottom: 15px;
        }

        .progress-labels {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: #a0aec0;
            margin-bottom: 5px;
        }

        .progress-bar-bg {
            width: 100%;
            height: 8px;
            background-color: #edf2f7;
            border-radius: 4px;
            overflow: hidden;
        }

        .progress-bar-fill {
            height: 100%;
            border-radius: 4px;
            transition: width 0.5s ease;
        }

        .bg-green {
            background-color: #48bb78;
        }

        .bg-yellow {
            background-color: #ecc94b;
        }

        .bg-red {
            background-color: #e53e3e;
        }

        /* BADGES */
        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 9999px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            align-self: flex-start;
            margin-bottom: 10px;
        }

        .badge-safe {
            background-color: rgba(72, 187, 120, 0.15);
            color: #38a169;
        }

        .badge-warning {
            background-color: rgba(236, 201, 75, 0.15);
            color: #d69e2e;
        }

        .badge-danger {
            background-color: rgba(245, 101, 101, 0.15);
            color: #e53e3e;
        }

        .badge-history {
            background-color: rgba(160, 174, 192, 0.15);
            color: #4a5568;
        }

        /* BUTTONS */
        .card-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 15px;
        }

        .btn-action {
            padding: 10px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            text-align: center;
            cursor: pointer;
            transition: background-color 0.2s;
            border: none;
        }

        .btn-return {
            background-color: #6b46c1;
            color: white;
        }

            .btn-return:hover {
                background-color: #553c9a;
            }

        .btn-renew {
            background-color: #edf2f7;
            color: #4a5568;
        }

            .btn-renew:hover {
                background-color: #e2e8f0;
            }

        .btn-disabled {
            background-color: #edf2f7;
            color: #a0aec0;
            cursor: not-allowed;
        }

        @@keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}

<div class="page-header">
    <h1>My Books</h1>
    <p>Manage your borrowed literature and view reading history.</p>
</div>

<div class="tabs-nav">
    <button class="tab-btn active status-tab" onclick="switchStatusTab('active', this)">Currently Borrowed</button>
    <button class="tab-btn status-tab" onclick="switchStatusTab('history', this)">Past Reads</button>

    <div class="filter-divider"></div>

    <button class="tab-btn active filter-tab" onclick="filterByType('All', this)">All</button>
    <button class="tab-btn filter-tab" onclick="filterByType('Book', this)">Books</button>
    <button class="tab-btn filter-tab" onclick="filterByType('Thesis', this)">Theses</button>
    <button class="tab-btn filter-tab" onclick="filterByType('Journal', this)">Journals</button>
</div>

<div id="active-books" class="books-grid">
    @if (Model.ActiveBorrowedBooks != null && Model.ActiveBorrowedBooks.Any())
    {
        foreach (var item in Model.ActiveBorrowedBooks)
        {
            var dueDate = item.ExpectedReturnDate ?? item.BorrowDate.AddDays(14);
            var totalAllowedDays = (dueDate - item.BorrowDate).TotalDays;
            if (totalAllowedDays <= 0) totalAllowedDays = 14;

            var daysElapsed = (DateTime.Now - item.BorrowDate).TotalDays;
            var percentElapsed = Math.Min(100, Math.Max(0, (daysElapsed / totalAllowedDays) * 100));
            var daysLeft = Math.Max(0, (int)(dueDate - DateTime.Now).TotalDays);

            var progressColorClass = "bg-green";
            var badgeClass = "badge-safe";
            var badgeText = $"{daysLeft} Days Left";

            if (percentElapsed > 80) { progressColorClass = "bg-red"; badgeClass = "badge-danger"; }
            else if (percentElapsed > 50) { progressColorClass = "bg-yellow"; badgeClass = "badge-warning"; }

            <div class="book-card" data-type="@item.Type">
                <span class="badge @badgeClass">@badgeText</span>
                <div class="book-title">@item.Title</div>
                <div class="book-author">by @item.Author</div>

                <div class="progress-container">
                    <div class="progress-labels">
                        <span>Borrowed: @item.BorrowDate.ToString("MMM dd")</span>
                        <span>Due: @dueDate.ToString("MMM dd")</span>
                    </div>
                    <div class="progress-bar-bg">
                        <div class="progress-bar-fill @progressColorClass" style="width: @percentElapsed%"></div>
                    </div>
                </div>

                <div class="card-actions">
                    <form asp-controller="Books" asp-action="Return" asp-route-id="@item.BorrowingRecordId" method="post" style="display:contents;">
                        <button type="submit" class="btn-action btn-return">Return</button>
                    </form>
                    <form asp-controller="Books" asp-action="Renew" asp-route-id="@item.BorrowingRecordId" method="post" style="display:contents;">
                        <button type="submit" class="btn-action btn-renew">Renew</button>
                    </form>
                </div>
            </div>
        }
    }
    else
    {
        <div class="no-data-msg" style="grid-column: 1 / -1; text-align: center; color: #718096; padding: 40px;">
            <p>You have no books borrowed at the moment. 📚</p>
        </div>
    }
</div>

<div id="history-books" class="books-grid" style="display:none;">
    @if (Model.PastReads != null && Model.PastReads.Any())
    {
        foreach (var item in Model.PastReads)
        {
            <div class="book-card" data-type="@item.Type">
                <span class="badge badge-history">Returned</span>
                <div class="book-title">@item.Title</div>
                <div class="book-author">by @item.Author</div>

                <div class="progress-labels" style="margin-top:10px;">
                    <span>Borrowed: @item.BorrowDate.ToString("yyyy-MM-dd")</span>
                    <span>Returned: @item.ActualReturnDate?.ToString("yyyy-MM-dd")</span>
                </div>

                <div class="card-actions">
                    <button class="btn-action btn-disabled" style="grid-column: 1 / span 2;">Archived</button>
                </div>
            </div>
        }
    }
    else
    {
        <div class="no-data-msg" style="grid-column: 1 / -1; text-align: center; color: #718096; padding: 40px;">
            <p>Your reading history is empty.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        let currentStatus = 'active';
        let currentType = 'All';

        function switchStatusTab(status, element) {
            currentStatus = status;

            // Toggle Tab Buttons
            document.querySelectorAll('.status-tab').forEach(btn => btn.classList.remove('active'));
            element.classList.add('active');

            // Show/Hide Sections
            document.getElementById('active-books').style.display = (status === 'active') ? 'grid' : 'none';
            document.getElementById('history-books').style.display = (status === 'history') ? 'grid' : 'none';

            // Re-apply type filter to the new visible section
            applyFilters();
        }

        function filterByType(type, element) {
            currentType = type;

            // Toggle Filter Buttons
            document.querySelectorAll('.filter-tab').forEach(btn => btn.classList.remove('active'));
            element.classList.add('active');

            applyFilters();
        }

        function applyFilters() {
            const containerId = (currentStatus === 'active') ? 'active-books' : 'history-books';
            const cards = document.querySelectorAll(`#${containerId} .book-card`);
            let visibleCount = 0;

            cards.forEach(card => {
                const cardType = card.getAttribute('data-type');
                if (currentType === 'All' || cardType === currentType) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // Handle "No results" message for sub-filtering
            const container = document.getElementById(containerId);
            let msg = container.querySelector('.filter-empty-msg');

            if (visibleCount === 0) {
                if (!msg) {
                    msg = document.createElement('div');
                    msg.className = 'filter-empty-msg';
                    msg.style = "grid-column: 1 / -1; text-align: center; color: #718096; padding: 40px;";
                    msg.innerHTML = `<p>No ${currentType}s found in this section.</p>`;
                    container.appendChild(msg);
                }
            } else if (msg) {
                msg.remove();
            }
        }
    </script>
}